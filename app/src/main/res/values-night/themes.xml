<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Outbreath" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/wave_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <item name="colorSecondary">@color/wave_secondary</item>
        <item name="colorSecondaryVariant">@color/wave_secondary</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:windowBackground">@color/background</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Outbreath.BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>